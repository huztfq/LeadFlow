# Supabase: Project Settings → Database → Connection string (URI)
# Use the direct connection for migrations; pooled/transaction mode is fine for the app.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

APOLLO_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL="Leadflow <onboarding@resend.dev>"

# Login password for the single-operator session (also signs the session JWT).
# Use a long, random value — it is a secret, not a memorable password.
APP_PASSWORD=

# HMAC secret for signed unsubscribe links. Must be different from
# APP_PASSWORD: unsubscribe links are mailed out (a public message/signature
# pair), so reusing APP_PASSWORD would let anyone brute-force the login
# password offline from an email they received. Falls back to APP_PASSWORD
# if unset, but only do that for local dev — always set this in production.
UNSUBSCRIBE_SECRET=

CRON_SECRET=
APP_URL=http://localhost:3000
