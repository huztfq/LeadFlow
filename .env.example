# Supabase: Project Settings → Database → Connection string (URI)
# Wrap in double quotes. If the password has # @ % / etc, URL-encode them
# (e.g. # → %23) or the host will break and Contacts will fail to load.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

APOLLO_API_KEY=
RESEND_API_KEY=
# Add and verify a sending domain from the "Domain" page in the app (uses the
# Resend Domains API under RESEND_API_KEY), then point this at a verified
# address on that domain, e.g. "Leadflow <hello@inferfaform.com>". Until a
# domain is verified, keep the onboarding@resend.dev sandbox address below.
RESEND_FROM_EMAIL="Leadflow <onboarding@resend.dev>"

# Claude (Anthropic) for Studio chat + plan design
ANTHROPIC_API_KEY=
# Optional: override the Studio model (default: claude-sonnet-5)
ANTHROPIC_MODEL=claude-sonnet-5

# Login password for the owner's session (also signs the session JWT). Use a
# long, random value — it is a secret, not a memorable password. On first
# successful login with this password, an `owner` User row is bootstrapped
# automatically (see OWNER_EMAIL below) — everyone invited after that signs
# in with their own email + password from /settings/team.
APP_PASSWORD=

# Optional: email address for the bootstrap owner account created on first
# APP_PASSWORD login. Defaults to "owner@leadflow.local" if unset — only
# matters if you want the owner row to have a real, recognizable email.
OWNER_EMAIL=

# HMAC secret for signed unsubscribe links. Must be different from
# APP_PASSWORD: unsubscribe links are mailed out (a public message/signature
# pair), so reusing APP_PASSWORD would let anyone brute-force the login
# password offline from an email they received. Falls back to APP_PASSWORD
# if unset, but only do that for local dev — always set this in production.
UNSUBSCRIBE_SECRET=

CRON_SECRET=
APP_URL=http://localhost:3000

# Signing secret for the Resend webhook (Dashboard → Webhooks → your endpoint
# → "Signing secret", looks like whsec_...). Verifies email.opened/clicked/
# bounced events posted to /api/webhooks/resend. If unset, the endpoint still
# accepts requests (useful for local testing with curl) but logs a warning —
# always set this in production.
RESEND_WEBHOOK_SECRET=

# Optional: Google Calendar OAuth (Calendar page → "Connect Google Calendar").
# Create an OAuth client (type "Web application") in Google Cloud Console,
# enable the Google Calendar API, and add GOOGLE_REDIRECT_URI as an authorized
# redirect URI. If left unset, the Calendar page falls back to an iCal feed
# URL or a plain booking link instead — no OAuth required for those.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback

# Optional: "Sign in with Google" on the login page (identity only — separate
# from Calendar's Google OAuth above, and invite-only: it signs in an
# existing account or auto-accepts a still-pending invite by matching email,
# and bounces anyone else to the waitlist). Reuses GOOGLE_CLIENT_ID/SECRET
# above (a Google OAuth client supports multiple redirect URIs) — just add
# this one as an additional authorized redirect URI on the same client. If
# left unset, the Google button on /login shows a "not set up yet" message
# instead of a broken flow.
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
